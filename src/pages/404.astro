---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="There's no page here.">
  <section class="nf wrap">
    <span class="code" aria-hidden="true">404</span>
    <h1>There’s no page here</h1>
    <p>It moved, or it never was.</p>
    <div class="nf-cta">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/docs" class="btn btn-ghost">Read the docs</a>
    </div>
  </section>
</Base>
