---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="There's no page here.">
  <section class="band band-hero">
    <div class="nf">
      <span class="doc-eyebrow">Error 404</span>
      <h1>There’s no page here</h1>
      <p>It moved, or it never was.</p>
      <div class="nf__cta">
        <a href="/" class="btn btn-primary">Back home</a>
        <a href="/docs" class="btn btn-secondary">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    max-width: 620px;
    margin-inline: auto;
    padding: clamp(70px, 14vh, 140px) var(--cell-pad);
    text-align: center;
  }
  .nf .doc-eyebrow { justify-content: center; margin-bottom: var(--space-6); }
  .nf h1 {
    font: 600 clamp(2.1rem, 1.6rem + 2vw, 2.9rem) / 1.05 var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--color-ink-strong);
    margin: 0;
  }
  .nf p { color: var(--color-ink-3); margin-top: var(--space-3); }
  .nf__cta { display: flex; gap: var(--space-3); justify-content: center; margin-top: var(--space-8); }
</style>
