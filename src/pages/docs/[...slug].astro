---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { site } from "../../site";
import { lastmod, breadcrumbs } from "../../seo";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const modified = lastmod(`src/content/docs/${entry.id}.md`);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: entry.data.title,
    description: entry.data.description,
    url: `${site.url}/docs/${entry.id}`,
    dateModified: modified,
    about: { "@id": `${site.url}/#app` },
    isPartOf: { "@type": "CollectionPage", "@id": `${site.url}/docs`, name: `${site.name} documentation` },
    publisher: { "@id": `${site.url}/#organization` },
    articleSection: entry.data.section,
    inLanguage: "en",
  },
  { "@context": "https://schema.org", ...breadcrumbs([["Home", "/"], ["Docs", "/docs"], [entry.data.title, `/docs/${entry.id}`]]) },
];
---

<Docs title={entry.data.title} description={entry.data.description} jsonLd={jsonLd} current={entry.id} markdown={`/docs/${entry.id}.md`}>
  <article class="prose">
    <Content />

    <div class="doc-meta">
      <span>{entry.data.section}</span>
      <a href={`/docs/${entry.id}.md`}>View as Markdown</a>
      <a href="/llms-full.txt">llms-full.txt</a>
    </div>

    <nav class="pager" aria-label="Pagination">
      {prev ? (
        <a class="prev" href={`/docs/${prev.id}`}>
          <span class="dir">Previous</span>
          <span class="ttl">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="next" href={`/docs/${next.id}`}>
          <span class="dir">Next</span>
          <span class="ttl">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</Docs>
