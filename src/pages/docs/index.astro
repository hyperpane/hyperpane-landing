---
import { getCollection } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { site } from "../../site";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const sections: { name: string; items: typeof docs }[] = [];
for (const doc of docs) {
  let group = sections.find((s) => s.name === doc.data.section);
  if (!group) sections.push((group = { name: doc.data.section, items: [] }));
  group.items.push(doc);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${site.name} documentation`,
  url: `${site.url}/docs`,
  description: `Documentation for ${site.name}.`,
};
---

<Docs title="Documentation" description={`Documentation for ${site.name}.`} jsonLd={jsonLd} current="__index">
  <header class="doc-head">
    <span class="doc-eyebrow">Documentation</span>
    <h1>Learn hyperpane</h1>
    <p class="lead">Start here, then go through the topics below.</p>
  </header>

  <div class="cards">
    {sections.map((section, n) => (
      <section class="cards__section">
        <h2 class="cards__h">{section.name}</h2>
        <div class="cards__grid">
          {section.items.map((doc) => (
            <a class="dcard" data-section={n} href={`/docs/${doc.id}`}>
              <svg class="fact-icon" aria-hidden="true"><use href={`#${["i-star", "i-layers", "i-puzzle"][n] ?? "i-file-text"}`}></use></svg>
              <h3>{doc.data.title}</h3>
              <p>{doc.data.description}</p>
              <span class="dcard__go">Read<svg class="icon" aria-hidden="true"><use href="#i-right"></use></svg></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Docs>
