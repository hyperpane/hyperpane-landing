---
import { getCollection } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { site } from "../../site";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const sections: { name: string; items: typeof docs }[] = [];
for (const doc of docs) {
  let group = sections.find((s) => s.name === doc.data.section);
  if (!group) sections.push((group = { name: doc.data.section, items: [] }));
  group.items.push(doc);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${site.name} documentation`,
  url: `${site.url}/docs`,
  description: `Documentation for ${site.name}.`,
};
---

<Docs title="Documentation" description={`Documentation for ${site.name}.`} jsonLd={jsonLd} current="__index" toc={false}>
  <header class="dhero">
    <h1>Learn hyperpane</h1>
    <p class="lead">Start here, then go through the topics below.</p>
  </header>
  <figure class="dshot">
    <img src="/shots/page-settings.webp" width="2400" height="1444" alt="hyperpane’s Settings, with its sections in the sidebar" loading="eager" decoding="async" />
  </figure>
  {sections.map((section, n) => (
    <section class="dcards">
      <h2>{section.name}</h2>
      <div class="dcards-grid">
        {section.items.map((doc) => (
          <a class="dcard" href={`/docs/${doc.id}`}>
            <span class="tile-icon" aria-hidden="true"><svg class="icon"><use href={`#${["i-star", "i-layers", "i-puzzle", "i-code"][n] ?? "i-file-text"}`}></use></svg></span>
            <h3>{doc.data.title}</h3>
            <p>{doc.data.description}</p>
            <span class="link">Read<svg class="icon" aria-hidden="true"><use href="#i-right"></use></svg></span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Docs>
