---
import { site } from "../site";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/home.css";
import "../styles/docs.css";
import "../styles/download.css";

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  type?: "website" | "article";
}

const { title, description = site.description, jsonLd, type = "website" } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline.replace(/\.$/, "").toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, "") || site.url;

// What hyperpane is, on every page.
const baseLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux",
  description: site.description,
  url: site.url,
};
const ldList = [baseLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<link rel="alternate" type="text/markdown" href={`${site.url}/llms.txt`} title="llms.txt" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={`${site.url}/icon.png`} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#050505" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500;700&display=swap" />

{ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
