---

<div class:list={["mw", `mw-${kind}`, cls]} data-tint={tint} style={style}>
  <div class="mw-head">
    <span class="mw-tile" aria-hidden="true"><svg class="icon"><use href={`#${icons[kind]}`}></use></svg></span>
    <span class="mw-title">{head}{subtitle && <small>{subtitle}</small>}</span>
    <span class="mw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
  <svg class="mw-body" viewBox={`0 0 400 ${body.h}`} aria-hidden="true" set:html={body.svg} />
</div>
