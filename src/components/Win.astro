---
// A drawn window of the app: its header (an icon in a tile, the title, ⋯)
// over a body drawn in SVG for its kind, in the app's colours. It scales
// with its width (container units); its insides move once it's in view
// (a parent with .is-in, or [data-live]).
interface Props {
  kind:
    | "terminal" | "editor" | "explorer" | "git" | "browser" | "data" | "requests"
    | "containers" | "tunnels" | "env" | "codestats" | "activity" | "agent";
  title?: string;
  sub?: string;
  /** The header's colour (the app's header colours). */
  tint?: "green" | "blue" | "violet" | "amber" | "rose";
  class?: string;
  style?: string;
}
const { kind, title, sub, tint, class: cls, style } = Astro.props;

const icons: Record<Props["kind"], string> = {
  terminal: "i-terminal", editor: "i-editor", explorer: "i-explorer", git: "i-git", browser: "i-browser",
  data: "i-database", requests: "i-arrows", containers: "i-box", tunnels: "i-link", env: "i-key",
  codestats: "i-chart", activity: "i-activity", agent: "i-bot",
};
const titles: Record<Props["kind"], [string, string?]> = {
  terminal: ["zsh", "~/dev/api"], editor: ["orders.ts", "src/routes"], explorer: ["api"], git: ["api · main", "1 change"],
  browser: ["localhost:5173"], data: ["Data — orders"], requests: ["GET /orders"], containers: ["Containers", "fra-1"],
  tunnels: ["Tunnels"], env: [".env", "4 values"], codestats: ["Code Stats · api"], activity: ["Activity", "This Mac"],
  agent: ["agent", "~/dev/api"],
};
const [t0, s0] = titles[kind];
const head = title ?? t0;
const subtitle = sub ?? s0;

// Bars standing for code: [x, width, class] per line.
type Seg = [number, number, string];
const code = (lines: Seg[][], x0: number, y0: number, gap = 17, num = true) =>
  lines
    .map((segs, i) => {
      const y = y0 + i * gap;
      const n = num ? `<text class="w-num" x="${x0 - 10}" y="${y + 6}" text-anchor="end">${i + 1}</text>` : "";
      return n + segs.map(([x, w, c]) => `<rect class="${c}" x="${x0 + x}" y="${y}" width="${w}" height="7" rx="3.5"/>`).join("");
    })
    .join("");

