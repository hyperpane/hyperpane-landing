  explorer: `${L("M70 44v110M70 72h40M70 112h40M70 152h40M110 112v32M110 132h40")}${rect(54, 30, 32, 22, 4)}${rect(110, 62, 70, 20, 4)}${rect(110, 102, 70, 20, 4)}${A("M150 122h64v20h-64z")}${rect(110, 142, 70, 20, 4)}${T(220, 136, "orders.ts")}${C("M190 72h80M190 112h20")}`,
  git: `${C("M40 60H290M40 140H290")}${L("M50 60H290")}${A("M120 60c30 0 30 80 60 80h50c30 0 30-80 60-80")}${dot(80, 60)}${dot(120, 60)}${dot(180, 140, "bp-adot")}${dot(230, 140, "bp-adot")}${dot(290, 60)}${dot(200, 60)}${T(50, 50, "main")}${T(180, 160, "feature")}`,
