const svg = big[kind] ?? small[kind] ?? "";
const view = big[kind] ? "0 0 640 400" : "0 0 320 200";
---

<svg class:list={["bp", cls]} viewBox={view} style={`--hue:var(--h-${hue})`} aria-hidden="true" set:html={svg} />
