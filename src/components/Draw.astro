---
// Blueprint drawings: what each window or role is, in a few lines, the way
// a plan draws it. Thin ink lines (drawn in as they come into view), dashed
// construction lines, small annotations, and one accent in the app's
// colours. No interfaces: an idea of the thing, not a picture of it.
interface Props {
  kind: string;
  /** The accent: one of the app's header hues. */
  hue?: "green" | "blue" | "cyan" | "violet" | "amber" | "rose" | "teal" | "orange";
  class?: string;
}
const { kind, hue = "blue", class: cls } = Astro.props;

// l: a line drawn in · c: construction (dashed) · a: the accent · t: a note
const L = (d: string) => `<path class="bp-l" pathLength="1" d="${d}"/>`;
const C = (d: string) => `<path class="bp-c" d="${d}"/>`;
const A = (d: string) => `<path class="bp-a" pathLength="1" d="${d}"/>`;
const T = (x: number, y: number, s: string, anchor = "start") => `<text class="bp-t" x="${x}" y="${y}" text-anchor="${anchor}">${s}</text>`;
const dot = (x: number, y: number, cls = "bp-dot") => `<circle class="${cls}" cx="${x}" cy="${y}" r="2.4"/>`;
const rect = (x: number, y: number, w: number, h: number, r = 8, cls = "bp-l") => `<rect class="${cls}" pathLength="1" x="${x}" y="${y}" width="${w}" height="${h}" rx="${r}"/>`;
// A dimension line with its ticks and a label.
const dim = (x1: number, y1: number, x2: number, y2: number, label: string) => {
  const h = y1 === y2;
  const t = h ? `M${x1} ${y1 - 4}v8M${x2} ${y2 - 4}v8` : `M${x1 - 4} ${y1}h8M${x2 - 4} ${y2}h8`;
  const lx = h ? (x1 + x2) / 2 : x1 + 8;
  const ly = h ? y1 - 6 : (y1 + y2) / 2 + 3;
  return `<path class="bp-dim" d="M${x1} ${y1}L${x2} ${y2}${t}"/>${T(lx, ly, label, h ? "middle" : "start")}`;
};
// A window as a plan draws it: its outline and the header's line.
const win = (x: number, y: number, w: number, h: number, label: string, accent = false) =>
  `${rect(x, y, w, h, 8, accent ? "bp-a" : "bp-l")}${L(`M${x} ${y + 16}H${x + w}`)}${T(x + 8, y + 11, label)}`;

