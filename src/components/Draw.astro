  "role-frontend": `${win(30, 40, 360, 300, "BROWSER", true)}${win(420, 40, 190, 160, "STYLES.CSS")}${win(420, 230, 190, 110, "ASSETS")}${A("M150 170a50 50 0 1 0 .1 0zM100 220h100M150 170c-20 18-20 82 0 100M150 170c20 18 20 82 0 100")}${C("M260 120h100M260 150h70M260 270h90")}${dim(30, 360, 390, 360, "phone · tablet · desktop")}`,
  "role-devops": `${win(30, 40, 250, 170, "CONTAINERS")}${win(310, 40, 300, 120, "TERMINAL · FRA-1", true)}${win(310, 190, 300, 150, "ACTIVITY")}${L("M80 150l40-20 40 20-40 20z")}${L("M80 150v28l40 20 40-20v-28M120 170v28")}${A("M336 300l26-10 26 6 26-30 26 10 26-34 26 12 26-22 26 6")}${A("M336 86l14 10-14 10")}${C("M30 240h250")}${T(30, 260, "every machine you run")}`,
  "role-data": `${win(30, 40, 260, 220, "DATA — ORDERS", true)}${win(320, 40, 290, 130, "REQUESTS")}${win(320, 200, 290, 150, "ORDERS.TS")}${A("M100 110c0-10 120-10 120 0s-120 10-120 0")}${L("M100 110v90c0 10 120 10 120 0v-90M100 140c0 10 120 10 120 0M100 170c0 10 120 10 120 0")}${L("M350 104h80m-10-6 10 6-10 6M520 116h-60m8-6-8 6 8 6")}${C("M290 150h30M290 270h30")}${T(350, 92, "query · call · compare")}`,
  "role-agents": `${A("M300 66l9 26 26 9-26 9-9 26-9-26-26-9 26-9z")}${win(30, 170, 180, 140, "AGENT · TERMINAL")}${win(230, 200, 170, 140, "TESTS")}${win(420, 170, 190, 160, "LOCALHOST:5173")}${C("M290 112L120 170M300 120l15 80M310 112l205 58")}${dot(120, 170, "bp-adot")}${dot(315, 200, "bp-adot")}${dot(515, 170, "bp-adot")}${T(340, 70, "you watch every window it touches")}`,
