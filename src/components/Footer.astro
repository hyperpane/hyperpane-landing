---
import { site } from "../site";
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div class="ftr-brand">
        <svg class="logotype" viewBox="0 0 624 117" role="img" aria-label={site.name}><use href="#logotype"></use></svg>
        <p>{site.tagline}</p>
      </div>
      <nav class="ftr-col" aria-label="Product">
        <h3>Product</h3>
        <a href="/#roles">Roles</a>
        <a href="/#plugins">Windows</a>
        <a href="/#detach">Always on</a>
        <a href="/download">Download</a>
        <a href="/faq">FAQ</a>
      </nav>
      <nav class="ftr-col" aria-label="Docs">
        <h3>Docs</h3>
        <a href="/docs">Overview</a>
        <a href="/docs/installation">Installation</a>
        <a href="/docs/plugins/writing">Write a plugin</a>
        <a href="/docs/reference/cli">The command line</a>
      </nav>
      <nav class="ftr-col" aria-label="More">
        <h3>More</h3>
        <a href="https://github.com/hyperpane">GitHub</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/llms-full.txt">llms-full.txt</a>
      </nav>
    </div>
    <div class="ftr-fine">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>macOS · Windows · Linux</span>
    </div>
  </div>
  <svg class="ftr-mark" viewBox="22.6 2.6 59.6 11.6" aria-hidden="true"><use href="#logotype" x="0" y="0" width="82" height="17"></use></svg>
</footer>
