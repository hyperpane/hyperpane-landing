---
// The docs: the site's header, then three columns: the contents on the
// left (sections and pages, as the app's sidebar rows), the page in the
// middle, and "On this page" on the right. On a phone the contents open
// from a bar under the header.
import { getCollection } from "astro:content";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Sprite from "../components/Sprite.astro";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The page shown (a doc's id; "__index" for the overview). */
  current?: string;
  /** "On this page" beside it (the overview has none). */
  toc?: boolean;
  /** The page as Markdown (docs/<id>.md), for LLMs. */
  markdown?: string;
}
const { title, description, jsonLd, current, toc = true, markdown } = Astro.props;

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const sections: { name: string; items: typeof docs }[] = [];
for (const doc of docs) {
  let group = sections.find((s) => s.name === doc.data.section);
  if (!group) sections.push((group = { name: doc.data.section, items: [] }));
  group.items.push(doc);
}
const depth = (id: string) => id.split("/").length - 1;
const page = docs.find((d) => d.id === current);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <Head title={title} description={description} jsonLd={jsonLd} type="article" markdown={markdown} />
  </head>
  <body class="is-docs">
    <Sprite />
    <a class="skip" href="#main">Skip to content</a>
    <Nav docs />
    <div class="dbar">
      <button class="dbar-toggle" type="button" aria-controls="docs-nav" aria-expanded="false" data-docs-toggle>
        <svg class="icon" aria-hidden="true"><use href="#i-panel-left"></use></svg>
        <span class="dbar-where">{page ? <>{page.data.section}<span class="dbar-sep" aria-hidden="true">/</span><strong>{page.data.title}</strong></> : <strong>Overview</strong>}</span>
      </button>
    </div>
    <div class="dlayout" class:list={["dlayout", { "has-toc": toc }]}>
      <aside class="dside" id="docs-nav" data-docs-nav>
        <nav aria-label="Documentation">
          <a href="/docs" class:list={["drow", { "is-on": current === "__index" }]} aria-current={current === "__index" ? "page" : undefined}>
            <svg class="icon" aria-hidden="true"><use href="#i-layers"></use></svg><span>Overview</span>
          </a>
          {sections.map((section) => (
            <div class="dgroup">
              <p class="dgroup-name">{section.name}</p>
              {section.items.map((doc) => (
                <a
                  href={`/docs/${doc.id}`}
                  class:list={["drow", { "is-on": current === doc.id, "is-sub": depth(doc.id) > 0 }]}
                  aria-current={current === doc.id ? "page" : undefined}
                >
                  <span>{doc.data.title}</span>
                </a>
              ))}
            </div>
          ))}
        </nav>
      </aside>
      <main id="main" class="dmain">
        <slot />
      </main>
      {toc && (
        <aside class="dtoc" aria-label="On this page">
          <p class="dtoc-title">On this page</p>
          <nav data-toc></nav>
        </aside>
      )}
    </div>
    <Footer />
    <script>
      import "../landing/site.js";
      import "../landing/docs.js";
    </script>
  </body>
</html>
